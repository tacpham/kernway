{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -d .codegraph && codegraph sync . >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 60,
            "statusMessage": "Syncing CodeGraph index"
          }
        ]
      }
    ]
  }
}
